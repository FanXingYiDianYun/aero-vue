{
  "name": "aero-vue",
  "version": "1.0.0",
  "description": "Aero UI - Vue 3 组件库，源自 AeroBase 设计体系：硬阴影签名交互、弹性动效、明暗双主题",
  "type": "module",
  "main": "./dist/aero-ui.umd.cjs",
  "module": "./dist/aero-ui.js",
  "types": "./dist/index.d.ts",
  "author": "FanXingYiDianYun",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "component-library"
  ],
  "repository": "https://github.com/FanXingYiDianYun/aero-vue",
  "homepage": "https://FanXingYiDianYun.github.io/aero-ui-view/",
  "bugs": "https://github.com/FanXingYiDianYun/aero-vue/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aero-ui.js",
      "require": "./dist/aero-ui.umd.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --noEmit",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/prepack-guard.mjs"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "sass": "^1.77.0",
    "typescript": "^5.4.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.0",
    "vue-tsc": "^2.0.0",
    "vitest": "^2.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^24.0.0"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "aero",
    "ui",
    "vue3",
    "component-library",
    "design-system"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  }
}
